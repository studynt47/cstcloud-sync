{
  "name": "cstcloud-sync",
  "version": "0.0.4",
  "description": "cstcloud-sync: Obsidian 笔记双向同步插件（基于 S3 / cstcloud.cn 对象存储）",
  "scripts": {
    "dev2": "node esbuild.config.mjs --watch",
    "build2": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "format": "npx @biomejs/biome check --write .",
    "clean": "npx rimraf main.js",
    "test": "mocha --import=tsx 'tests/**/*.ts'"
  },
  "browser": {
    "path": "path-browserify",
    "process": "process/browser",
    "stream": "stream-browserify",
    "crypto": "crypto-browserify",
    "url": "url/",
    "fs": false,
    "vm": false
  },
  "source": "main.ts",
  "keywords": [],
  "author": "fyears (upstream original) + cstcloud-sync contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.7",
    "@types/mime-types": "^2.1.4",
    "@types/mocha": "^10.0.7",
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.14.12",
    "builtin-modules": "^4.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "esbuild": "^0.23.0",
    "jsdom": "^24.1.1",
    "mocha": "^10.7.0",
    "obsidian": "^1.5.7",
    "ts-loader": "^9.5.1",
    "tslib": "^2.6.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/lib-storage": "^3.620.0",
    "@aws-sdk/signature-v4-crt": "^3.620.0",
    "@aws-sdk/types": "^3.609.0",
    "@fyears/tsqueue": "^1.0.1",
    "@sanity/diff-match-patch": "^3.1.1",
    "@smithy/fetch-http-handler": "^3.2.4",
    "@smithy/protocol-http": "^4.1.0",
    "@smithy/querystring-builder": "^3.0.3",
    "acorn": "^8.12.1",
    "aggregate-error": "^5.0.0",
    "assert": "^2.1.0",
    "aws-crt": "^1.21.3",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "emoji-regex": "^10.3.0",
    "http-status-codes": "^2.3.0",
    "localforage": "^1.10.0",
    "localforage-getitems": "^1.4.2",
    "localforage-removeitems": "^1.4.0",
    "lodash": "^4.17.21",
    "lucide": "^0.416.0",
    "mime-types": "^2.1.35",
    "mustache": "^4.2.0",
    "nanoid": "^5.0.7",
    "node-diff3": "^3.1.2",
    "openapi-fetch": "^0.10.2",
    "p-queue": "^8.0.1",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "rfc4648": "^1.5.3",
    "rimraf": "^6.0.1",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "xregexp": "^5.1.1"
  }
}
